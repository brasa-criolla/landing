---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HeroStrip from '../components/HeroStrip.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import MenuSection from '../components/MenuSection.astro';
import QualityCard from '../components/QualityCard.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout>
  <!-- Hero con impacto fotográfico gastronómico y botones de 4px radius -->
  <Hero />

  <!-- Franja de voltaje de escasez y promesa de calidad al momento -->
  <HeroStrip />

  <!-- Platos estrella / Especialidades en grid de 4 -->
  <FeaturedGrid />

  <!-- Menú completo con filtrado instantáneo por categorías -->
  <MenuSection />

  <!-- Sello de tradición artesanal y cocción a la leña -->
  <QualityCard />

  <!-- Ubicación física en La Plata Huila, horarios de servicio y mapa interactivo -->
  <ContactSection />
</Layout>
