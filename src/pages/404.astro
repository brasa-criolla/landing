---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { CATEGORIES } from '../data/menu';
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { buildWhatsAppLink } from '../lib/format';

const whatsappUrl = buildWhatsAppLink(RESTAURANT_INFO.whatsapp, RESTAURANT_INFO.whatsappDefaultMessage);
---

<Layout
  variant="carta"
  noindex
  title={`Página no encontrada | ${RESTAURANT_INFO.name}`}
  description={`La página que buscas no existe. Consulta la carta y los horarios de ${RESTAURANT_INFO.name} en La Plata, Huila.`}
>
  <div class="mx-auto max-w-3xl px-4 pb-16 pt-10 sm:pt-16">
    <p class="text-xs font-extrabold uppercase tracking-widest text-brand-red">Error 404</p>
    <h1 class="mt-1 font-display text-[2.75rem] uppercase leading-none tracking-wide text-ink">Esta página no existe</h1>
    <p class="mt-3 max-w-xl text-base text-ash">
      Puede que el enlace esté mal escrito o que la página ya no exista. La carta y los horarios siguen aquí.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/carta"
        class="inline-flex h-13 w-full items-center justify-center gap-2 rounded-sm border border-brand-red-dark bg-brand-red px-8 font-display text-xl uppercase tracking-wider text-white transition-colors hover:bg-brand-red-dark sm:w-auto"
      >
        Ver la carta
        <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
      </a>
      <a
        href="/"
        class="inline-flex h-13 w-full items-center justify-center gap-2 rounded-sm border border-ink px-8 font-display text-xl uppercase tracking-wider text-ink transition-colors hover:bg-ink hover:text-white sm:w-auto"
      >
        Ir al inicio
      </a>
    </div>

    <section aria-labelledby="atajos-title" class="mt-12 border-t border-hairline pt-6">
      <h2 id="atajos-title" class="text-xs font-extrabold uppercase tracking-widest text-ash">Ir directo a la carta</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {CATEGORIES.map((category) => (
          <li>
            <a
              href={`/carta#cat-${category.id}`}
              class="inline-flex h-11 items-center gap-1.5 rounded-sm border border-hairline bg-white px-3.5 text-sm font-bold text-ink transition-colors hover:border-ink"
            >
              <Icon name={category.icon} class="size-4" aria-hidden="true" />
              {category.shortName}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-10 text-base text-ash">
      <p>¿Quieres encargar para recoger?</p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-1.5 font-bold text-ink underline underline-offset-4"
      >
        <Icon name="simple-icons:whatsapp" class="size-4 text-brand-green" aria-hidden="true" />
        Escríbenos por WhatsApp
      </a>
      <p>Estamos en {RESTAURANT_INFO.address}, {RESTAURANT_INFO.neighborhood}.</p>
    </div>
  </div>
</Layout>

<script>
  // A broken NFC/QR link can still carry ?mesa=N; keep it so the menu header shows the table.
  const table = new URLSearchParams(window.location.search).get('mesa');
  if (table && /^\d{1,3}$/.test(table)) {
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/carta"]').forEach((link) => {
      const url = new URL(link.href);
      url.searchParams.set('mesa', table);
      link.href = url.pathname + url.search + url.hash;
    });
  }
</script>
