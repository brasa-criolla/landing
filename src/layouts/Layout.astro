---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import CartaHeader from '../components/CartaHeader.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { RESTAURANT_INFO, SITE_URL } from '../data/restaurant-info';
import { CATEGORIES, MENU_ITEMS } from '../data/menu';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  variant?: 'site' | 'carta';
  noindex?: boolean;
}

const {
  title = `${RESTAURANT_INFO.name} — ${RESTAURANT_INFO.tagline} | La Plata, Huila`,
  description = RESTAURANT_INFO.description,
  canonicalPath = '/',
  variant = 'site',
  noindex = false,
} = Astro.props;

const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const ogImage = `${SITE_URL}/og-image.jpg`;
const SCHEMA_DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: RESTAURANT_INFO.name,
  alternateName: 'Restaurante y Asadero La Brasa Criolla',
  image: ogImage,
  description: RESTAURANT_INFO.description,
  servesCuisine: ['Colombiana', 'Asados al Carbón', 'Pollo Asado', 'Pescados'],
  priceRange: '$$',
  currenciesAccepted: 'COP',
  paymentAccepted: 'Cash, Credit Card, Debit Card, Nequi, Daviplata, Bancolombia',
  acceptsReservations: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${RESTAURANT_INFO.address}, ${RESTAURANT_INFO.neighborhood}`,
    addressLocality: RESTAURANT_INFO.city,
    addressRegion: RESTAURANT_INFO.department,
    postalCode: '415060',
    addressCountry: 'CO',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 2.3907, longitude: -75.8927 },
  url: `${SITE_URL}/`,
  telephone: [RESTAURANT_INFO.phone, '+576088371470'],
  email: RESTAURANT_INFO.email,
  openingHoursSpecification: RESTAURANT_INFO.openingHours.map((entry) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: entry.days.map((day) => SCHEMA_DAYS[day]),
    opens: entry.opens,
    closes: entry.closes,
  })),
  sameAs: RESTAURANT_INFO.socialLinks.map((social) => social.url),
  hasMenu: {
    '@type': 'Menu',
    name: `Carta de ${RESTAURANT_INFO.name}`,
    url: `${SITE_URL}/carta`,
    hasMenuSection: CATEGORIES.map((category) => ({
      '@type': 'MenuSection',
      name: category.name,
      description: category.shortDescription,
      hasMenuItem: MENU_ITEMS.filter((item) => item.category === category.id).map((item) => ({
        '@type': 'MenuItem',
        name: item.name,
        ...(item.accompaniments.length > 0 && { description: `Incluye: ${item.accompaniments.join(', ')}` }),
        ...(item.price !== undefined && { offers: { '@type': 'Offer', price: item.price, priceCurrency: 'COP' } }),
      })),
    })),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="asadero la plata huila, restaurante la plata huila, pollo asado huila, carnes al carbon, comida tipica huila, picada mixta, la brasa criolla, barrio paez la plata"
    />
    <meta name="author" content="La Brasa Criolla" />
    <meta name="theme-color" content="#FCF9EC" />

    <!-- og:type "website" instead of "restaurant": that type needs a registered Facebook Open Graph object, and WhatsApp/Slack/LinkedIn ignore it. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={RESTAURANT_INFO.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Font cssVariable="--font-nunito" preload />
    <Font cssVariable="--font-bebas" preload />
  </head>
  <body class="flex min-h-dvh flex-col bg-cream text-ink antialiased" data-variant={variant}>
    <div id="top"></div>
    {variant === 'carta' ? <CartaHeader /> : <Navbar />}

    <main class="flex-grow">
      <slot />
    </main>

    {variant === 'site' && (
      <>
        <WhatsAppButton />
        <Footer />
      </>
    )}
  </body>
</html>
