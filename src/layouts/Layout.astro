---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { RESTAURANT_INFO } from '../data/restaurant-info';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${RESTAURANT_INFO.name} — ${RESTAURANT_INFO.tagline} | La Plata, Huila`,
  description = `${RESTAURANT_INFO.description} Ubicados en ${RESTAURANT_INFO.address}, ${RESTAURANT_INFO.city}. Teléfono: ${RESTAURANT_INFO.phoneDisplay}.`
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="asadero la plata huila, restaurante la plata huila, pollo asado huila, carnes al carbon, comida tipica huila, picada mixta, la brasa criolla" />
    <meta name="author" content="La Brasa Criolla" />
    <meta name="theme-color" content="#451400" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:url" content="https://brasacriolla.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={RESTAURANT_INFO.name} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts Preconnect & Loading: Bebas Neue + Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FCF9EC] text-[#451400] selection:bg-[#451400] selection:text-white antialiased">
    <div id="top"></div>
    <Navbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <WhatsAppButton />
    <Footer />
  </body>
</html>
