---
import { RESTAURANT_INFO } from '../data/restaurant-info';
---

<section id="contacto" class="py-16 sm:py-24 bg-[#FCF9EC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-extrabold uppercase tracking-widest text-[#C60101] block mb-2">
        Visítanos en La Plata, Huila
      </span>
      <h2 class="font-display text-4xl sm:text-6xl text-[#451400] uppercase tracking-wide leading-none mb-4">
        Ubicación & Horarios de Atención
      </h2>
      <p class="font-body text-sm sm:text-base text-[#786259]">
        Estamos ubicados en el corazón del municipio. Ven a disfrutar de un ambiente familiar y el mejor aroma parrillero.
      </p>
    </div>

    <!-- 2-Column Layout: Info Cards & Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Left Column: Location & Hours -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Address & Contact Card -->
        <div class="bg-white rounded-[4px] border border-[#D4CBC7] p-6 shadow-sm">
          <h3 class="font-display text-2xl text-[#451400] uppercase mb-4 flex items-center gap-2 border-b border-[#D4CBC7] pb-3">
            <svg class="w-6 h-6 text-[#C60101]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Dirección & Contacto</span>
          </h3>

          <div class="space-y-4 font-body text-sm text-[#451400]">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#786259] block">Punto Físico:</span>
              <p class="text-base font-bold text-[#171717]">{RESTAURANT_INFO.address}</p>
              <p class="text-xs text-[#786259]">{RESTAURANT_INFO.city}, {RESTAURANT_INFO.department} - Colombia</p>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#786259] block">Teléfono / WhatsApp:</span>
              <p class="text-base font-bold text-[#C60101]">{RESTAURANT_INFO.phoneDisplay}</p>
            </div>

            <div class="pt-2">
              <a 
                href={RESTAURANT_INFO.googleMapsDirectionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-[#451400] hover:bg-[#C60101] text-white py-2.5 px-4 rounded-[4px] text-xs font-bold uppercase tracking-wider transition-colors shadow-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <span>Abrir en Google Maps</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Schedule Card -->
        <div class="bg-white rounded-[4px] border border-[#D4CBC7] p-6 shadow-sm flex-grow">
          <h3 class="font-display text-2xl text-[#451400] uppercase mb-4 flex items-center gap-2 border-b border-[#D4CBC7] pb-3">
            <svg class="w-6 h-6 text-[#C60101]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Horarios de Servicio</span>
          </h3>

          <div class="space-y-3 font-body text-xs sm:text-sm">
            {RESTAURANT_INFO.schedule.map((item) => (
              <div class="flex items-center justify-between border-b border-[#D4CBC7]/40 pb-2">
                <span class="font-bold text-[#451400]">{item.days}</span>
                <span class="font-semibold text-[#786259]">{item.hours}</span>
              </div>
            ))}
          </div>

          <div class="mt-4 p-2.5 bg-[#FCF9EC] rounded-[4px] border border-[#D4CBC7] text-[11px] text-[#786259]">
            💡 <strong>Nota para fines de semana:</strong> Los sábados y domingos contamos con nuestra tradicional <em>Limonada de Panela Campesina</em>.
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Map Frame -->
      <div class="lg:col-span-7">
        <div class="w-full h-full min-h-[380px] bg-white rounded-[4px] border border-[#D4CBC7] overflow-hidden shadow-sm flex flex-col">
          <div class="bg-[#F4EFE0] px-4 py-2 border-b border-[#D4CBC7] flex items-center justify-between">
            <span class="font-display text-sm uppercase tracking-wider text-[#451400]">
              Mapa Satelital · La Plata, Huila
            </span>
            <span class="text-[11px] font-bold text-[#786259]">
              Cra. 4 #6-64
            </span>
          </div>

          <div class="relative flex-grow w-full min-h-[340px]">
            <iframe 
              src={RESTAURANT_INFO.googleMapsEmbedUrl} 
              class="w-full h-full absolute inset-0 border-0"
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de La Brasa Criolla en Carrera 4 # 6-64, La Plata, Huila, Colombia"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
