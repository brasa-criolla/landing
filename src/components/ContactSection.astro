---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { Icon } from 'astro-icon/components';
import OpenStatus from './OpenStatus.astro';

const payments = [
  { label: 'Efectivo', icon: 'lucide:banknote' },
  { label: 'Tarjetas Débito / Crédito', icon: 'lucide:credit-card' },
  { label: 'Nequi / Bancolombia / Daviplata', icon: 'lucide:smartphone' },
];
---

<section id="contacto" class="bg-cream py-14 sm:py-24" aria-labelledby="contacto-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
      <p class="mb-2 text-xs font-extrabold uppercase tracking-widest text-brand-red">Punto Físico en Barrio Páez</p>
      <h2 id="contacto-title" class="font-display text-4xl uppercase leading-none tracking-wide text-ink sm:text-6xl">
        Ubicación, Horarios & Domicilios en La Plata
      </h2>
      <p class="mt-4 text-base text-ash">
        Encuéntranos en la Cra. 4 #6-64 en La Plata, Huila, o pide tu domicilio por WhatsApp. Atendemos todos los días con el
        mejor ambiente familiar.
      </p>
    </div>

    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div class="rounded-sm border border-hairline bg-white p-5 shadow-sm sm:p-6">
          <h3 class="mb-4 flex items-center gap-2 border-b border-hairline pb-3 font-display text-[1.75rem] uppercase text-ink">
            <Icon name="lucide:map-pin" class="size-6 text-brand-red" aria-hidden="true" />
            Dirección & Contacto
          </h3>

          <div class="space-y-4 text-sm text-ink">
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-ash">Punto Físico:</span>
              <p class="text-base font-bold text-[#171717]">{RESTAURANT_INFO.address}, {RESTAURANT_INFO.neighborhood}</p>
              <p class="text-sm text-ash">{RESTAURANT_INFO.city}, {RESTAURANT_INFO.department} · Colombia</p>
            </div>

            <div class="grid grid-cols-1 gap-x-3 sm:grid-cols-2">
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-ash">Celular / WhatsApp:</span>
                <a
                  href={`https://wa.me/${RESTAURANT_INFO.whatsapp}`}
                  class="inline-flex min-h-11 items-center text-base font-bold text-brand-red hover:underline"
                >
                  {RESTAURANT_INFO.phoneDisplay}
                </a>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-ash">Teléfono Fijo:</span>
                <a href="tel:+576088371470" class="inline-flex min-h-11 items-center text-base font-bold text-ink hover:underline">
                  {RESTAURANT_INFO.phoneLandline}
                </a>
              </div>
            </div>

            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-ash">Correo Electrónico:</span>
              <a
                href={`mailto:${RESTAURANT_INFO.email}`}
                class="inline-flex min-h-11 items-center break-all text-base font-semibold text-ink hover:text-brand-red"
              >
                {RESTAURANT_INFO.email}
              </a>
            </div>

            <div class="border-t border-hairline/40 pt-3">
              <span class="mb-2 block text-xs font-bold uppercase tracking-wider text-ash">Medios de Pago Aceptados:</span>
              <ul class="flex flex-wrap gap-2">
                {payments.map((payment) => (
                  <li class="inline-flex items-center gap-1.5 rounded-sm border border-hairline bg-cream px-2.5 py-1 text-sm font-bold text-ink">
                    <Icon name={payment.icon} class="size-4" aria-hidden="true" />
                    {payment.label}
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={RESTAURANT_INFO.googleMapsDirectionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-12 w-full items-center justify-center gap-2 rounded-sm bg-ink px-4 text-sm font-bold uppercase tracking-wider text-white shadow-sm transition-colors hover:bg-brand-red"
            >
              <Icon name="lucide:navigation" class="size-4" aria-hidden="true" />
              Cómo Llegar en Google Maps
            </a>
          </div>
        </div>

        <div class="flex-grow rounded-sm border border-hairline bg-white p-5 shadow-sm sm:p-6">
          <h3 class="mb-3 flex items-center gap-2 border-b border-hairline pb-3 font-display text-[1.75rem] uppercase text-ink">
            <Icon name="lucide:clock" class="size-6 text-brand-red" aria-hidden="true" />
            Horarios de Servicio
          </h3>

          <OpenStatus class="mb-2 text-sm font-bold text-ink" />

          <dl class="divide-y divide-hairline/40 text-sm">
            {RESTAURANT_INFO.schedule.map((item) => (
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="font-bold text-ink">{item.days}</dt>
                <dd class="text-right font-semibold text-ash">{item.hours}</dd>
              </div>
            ))}
          </dl>

          <p class="mt-4 flex items-start gap-2 rounded-sm border border-hairline bg-cream p-3 text-sm text-ash">
            <Icon name="lucide:lightbulb" class="mt-0.5 size-4 shrink-0 text-ink" aria-hidden="true" />
            <span>
              <strong class="text-ink">Nota para fines de semana:</strong> Los sábados y domingos contamos con nuestra
              tradicional <em>Limonada de Panela Campesina</em>.
            </span>
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="flex h-full min-h-[320px] flex-col overflow-hidden rounded-sm border border-hairline bg-white shadow-sm">
          <div class="flex items-center justify-between gap-3 border-b border-hairline bg-cream-muted px-4 py-2.5">
            <span class="text-xs font-extrabold uppercase tracking-wider text-ink">Mapa · La Plata, Huila</span>
            <span class="text-xs font-bold text-ash">{RESTAURANT_INFO.address}</span>
          </div>
          <div class="relative min-h-[280px] flex-grow">
            <button
              type="button"
              data-map-load={RESTAURANT_INFO.googleMapsEmbedUrl}
              class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-cream-muted p-6 text-center text-ink transition-colors hover:bg-hairline/40"
            >
              <Icon name="lucide:map-pin" class="size-9 text-brand-red" aria-hidden="true" />
              <span class="font-display text-[1.75rem] uppercase tracking-wide">Ver mapa interactivo</span>
              <span class="text-sm text-ash">Toca para cargar Google Maps</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The Google Maps embed weighs far more than the rest of the page, so phones only load it on request.
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((button) => {
    const loadMap = () => {
      const iframe = document.createElement('iframe');
      iframe.src = button.dataset.mapLoad ?? '';
      iframe.title = 'Ubicación de La Brasa Criolla en Carrera 4 # 6-64, La Plata, Huila, Colombia';
      iframe.className = 'absolute inset-0 size-full border-0';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      button.replaceWith(iframe);
    };

    button.addEventListener('click', loadMap);
    if (window.matchMedia('(min-width: 1024px)').matches) loadMap();
  });
</script>
