---
import logoImg from '../assets/logo-oficial.png';
import { Image } from 'astro:assets';
import OpenStatus from './OpenStatus.astro';
---

<header id="main-header" class="sticky top-0 z-50 w-full border-b border-ink/10 bg-cream/95 backdrop-blur-md">
  <div class="mx-auto flex h-(--header-h) max-w-3xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-h-11 shrink-0 items-center rounded-sm" aria-label="La Brasa Criolla - ir al inicio">
      <Image src={logoImg} alt="" height={130} loading="eager" class="h-10 w-auto object-contain" />
    </a>
    <div class="flex min-w-0 items-center gap-2">
      <span
        data-table-label
        hidden
        class="shrink-0 rounded-sm bg-ink px-2 py-1 text-xs font-extrabold uppercase tracking-wide text-brand-gold"
      ></span>
      <OpenStatus compact class="min-w-0 truncate text-xs font-bold text-ink" />
    </div>
  </div>
</header>

<script>
  const table = new URLSearchParams(window.location.search).get('mesa');
  const tableLabel = document.querySelector<HTMLElement>('[data-table-label]');
  if (tableLabel && table && /^\d{1,3}$/.test(table)) {
    tableLabel.textContent = `Mesa ${table}`;
    tableLabel.hidden = false;
  }
</script>
