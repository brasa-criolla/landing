---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { buildWhatsAppLink } from '../lib/format';
import { Icon } from 'astro-icon/components';

const waUrl = buildWhatsAppLink(RESTAURANT_INFO.whatsapp, RESTAURANT_INFO.whatsappDefaultMessage);
---

<aside class="group fixed bottom-4 right-4 z-40 flex items-center sm:bottom-6 sm:right-6" aria-label="Contacto directo por WhatsApp">
  <div
    class="pointer-events-none mr-3 hidden whitespace-nowrap rounded-sm border border-white/20 bg-ink px-3 py-1.5 text-xs font-bold text-white opacity-0 shadow-lg transition-opacity duration-200 group-hover:opacity-100 sm:block"
  >
    ¿Quieres encargar? Escríbenos
  </div>
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="pulse-whatsapp flex size-13 items-center justify-center rounded-sm border-2 border-white bg-brand-green text-white shadow-2xl transition-colors hover:bg-brand-green-dark"
    aria-label="Encargar por WhatsApp"
  >
    <Icon name="simple-icons:whatsapp" class="size-7" aria-hidden="true" />
  </a>
</aside>
