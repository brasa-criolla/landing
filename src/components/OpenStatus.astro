---
import { RESTAURANT_INFO } from '../data/restaurant-info';

interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className, compact = false } = Astro.props;
const schedule = { weekly: RESTAURANT_INFO.openingHours, holidays: RESTAURANT_INFO.holidayHours };
---

<span
  class:list={['group inline-flex items-center gap-2', className]}
  data-open-status
  data-compact={compact ? '' : undefined}
  data-schedule={JSON.stringify(schedule)}
>
  <span
    class="size-2 shrink-0 rounded-full bg-current opacity-60 group-data-[state=closed]:bg-brand-red group-data-[state=closed]:opacity-100 group-data-[state=open]:bg-open group-data-[state=open]:opacity-100"
    aria-hidden="true"
  ></span>
  <span data-open-status-text>Martes a domingo y festivos</span>
</span>

<script>
  import { describeOpenStatus, type Schedule } from '../lib/schedule';

  function render() {
    document.querySelectorAll<HTMLElement>('[data-open-status]').forEach((element) => {
      const schedule: Schedule = JSON.parse(element.dataset.schedule ?? '{}');
      const status = describeOpenStatus(schedule, 'compact' in element.dataset);
      const text = element.querySelector('[data-open-status-text]');
      if (!status || !text) return;
      element.dataset.state = status.state;
      text.textContent = status.text;
    });
  }

  render();
  setInterval(render, 60_000);
</script>
