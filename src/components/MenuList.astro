---
import { CATEGORIES, MENU_ITEMS } from '../data/menu';
import DishRow from './DishRow.astro';
import DishSheet from './DishSheet.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  headingLevel: 'h2' | 'h3';
  allowOrdering: boolean;
}

const { headingLevel, allowOrdering } = Astro.props;
const CategoryHeading = headingLevel;
const dishHeadingLevel = headingLevel === 'h2' ? 'h3' : 'h4';
const categories = CATEGORIES.map((category) => ({
  ...category,
  items: MENU_ITEMS.filter((item) => item.category === category.id),
}));
---

<div>
  <nav
    aria-label="Categorías de la carta"
    class="sticky top-(--header-h) z-30 -mx-4 border-b border-ink/10 bg-cream/95 backdrop-blur-md sm:mx-0 sm:rounded-sm sm:border"
  >
    <ul class="no-scrollbar relative flex gap-2 overflow-x-auto px-4 py-2.5 sm:justify-center" data-menu-nav>
      {categories.map((category) => (
        <li class="shrink-0">
          <a
            href={`#cat-${category.id}`}
            data-menu-link={category.id}
            class="inline-flex h-11 items-center gap-1.5 rounded-sm border border-hairline bg-white px-3.5 text-sm font-bold text-ink transition-colors aria-[current=true]:border-ink aria-[current=true]:bg-ink aria-[current=true]:text-white"
          >
            <Icon name={category.icon} class="size-4" aria-hidden="true" />
            {category.shortName}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {categories.map((category) => (
    <section
      id={`cat-${category.id}`}
      aria-labelledby={`cat-${category.id}-title`}
      class="scroll-mt-[calc(var(--header-h)_+_4.5rem)] pt-8"
      data-menu-category={category.id}
    >
      <div class="flex items-center gap-2.5 border-b-2 border-ink pb-2">
        <Icon name={category.icon} class="size-6 shrink-0 text-ink" aria-hidden="true" />
        <CategoryHeading
          id={`cat-${category.id}-title`}
          class="font-display text-[1.75rem] uppercase leading-none tracking-wide text-ink"
        >
          {category.name}
        </CategoryHeading>
      </div>
      <ul class="divide-y divide-hairline/70 md:grid md:grid-cols-2 md:gap-x-10 md:divide-y-0">
        {category.items.map((dish) => (
          <li class="md:border-b md:border-hairline/70">
            <DishRow dish={dish} headingLevel={dishHeadingLevel} />
          </li>
        ))}
      </ul>
    </section>
  ))}

  <DishSheet allowOrdering={allowOrdering} />
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-menu-nav]');
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]')].map((link) => [link.dataset.menuLink, link]),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('[data-menu-category]')];

  function setActive(id: string) {
    links.forEach((link, key) => {
      if (key === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    const active = links.get(id);
    if (nav && active) {
      nav.scrollTo({ left: active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2, behavior: 'smooth' });
    }
  }

  if (nav && sections.length > 0) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).dataset.menuCategory ?? '';
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }
        const current = sections.find((section) => visible.has(section.dataset.menuCategory ?? ''));
        if (current) setActive(current.dataset.menuCategory ?? '');
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
