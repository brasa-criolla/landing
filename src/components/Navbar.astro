---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { buildWhatsAppLink } from '../lib/format';
import logoImg from '../assets/logo-oficial.png';
import { Image } from 'astro:assets';

const waUrl = buildWhatsAppLink(RESTAURANT_INFO.whatsapp, RESTAURANT_INFO.whatsappDefaultMessage);
---

<header id="main-header" class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#FCF9EC]/95 backdrop-blur-md border-b border-[#451400]/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo (Official round badge taking full space) -->
    <a href="#top" class="flex items-center group focus:outline-none py-1" aria-label="La Brasa Criolla - Inicio">
      <Image 
        src={logoImg} 
        alt="La Brasa Criolla — Asadero & Restaurante en La Plata, Huila" 
        class="h-14 sm:h-16 w-auto max-w-[180px] sm:max-w-[220px] object-contain filter drop-shadow-sm transition-transform duration-200 group-hover:scale-105" 
        height={130}
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación Principal">
      <a href="#inicio" class="text-sm font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] transition-colors py-1 border-b-2 border-transparent hover:border-[#C60101]">
        Inicio
      </a>
      <a href="#destacados" class="text-sm font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] transition-colors py-1 border-b-2 border-transparent hover:border-[#C60101]">
        Especialidades
      </a>
      <a href="#menu" class="text-sm font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] transition-colors py-1 border-b-2 border-transparent hover:border-[#C60101]">
        La Carta
      </a>
      <a href="#tradicion" class="text-sm font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] transition-colors py-1 border-b-2 border-transparent hover:border-[#C60101]">
        Tradición
      </a>
      <a href="#contacto" class="text-sm font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] transition-colors py-1 border-b-2 border-transparent hover:border-[#C60101]">
        Ubicación
      </a>
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="hidden md:flex items-center gap-4">
      <a 
        href={`tel:${RESTAURANT_INFO.phone}`} 
        class="hidden lg:flex items-center gap-1.5 text-xs font-bold text-[#786259] hover:text-[#451400] transition-colors uppercase tracking-wider"
      >
        <svg class="w-4 h-4 text-[#C60101]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {RESTAURANT_INFO.phoneDisplay}
      </a>

      <!-- Chipotle-style CTA: 4px radius, compact, high-contrast -->
      <a 
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-[#C60101] hover:bg-[#8F0000] text-white px-4 h-10 rounded-[4px] text-xs font-extrabold tracking-wider uppercase transition-all shadow-sm active:scale-95 border border-[#8F0000]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Pedir WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <a 
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-[#C60101] text-white p-2 rounded-[4px] border border-[#8F0000] flex items-center justify-center"
        aria-label="Pedir por WhatsApp"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>

      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="p-2 text-[#451400] hover:text-[#C60101] focus:outline-none rounded-[4px] border border-[#451400]/20"
        aria-expanded="false" 
        aria-label="Abrir Menú"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#451400]/15 bg-[#FCF9EC] px-4 pt-3 pb-6 space-y-3">
    <a href="#inicio" class="mobile-nav-link block py-2 text-base font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] border-b border-[#451400]/10">
      Inicio
    </a>
    <a href="#destacados" class="mobile-nav-link block py-2 text-base font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] border-b border-[#451400]/10">
      Especialidades
    </a>
    <a href="#menu" class="mobile-nav-link block py-2 text-base font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] border-b border-[#451400]/10">
      La Carta Completa
    </a>
    <a href="#tradicion" class="mobile-nav-link block py-2 text-base font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101] border-b border-[#451400]/10">
      Nuestra Tradición
    </a>
    <a href="#contacto" class="mobile-nav-link block py-2 text-base font-bold uppercase tracking-wider text-[#451400] hover:text-[#C60101]">
      Ubicación & Horarios
    </a>

    <div class="pt-2">
      <a 
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 bg-[#C60101] text-white py-3 rounded-[4px] text-sm font-extrabold uppercase tracking-wider shadow-sm border border-[#8F0000]"
      >
        <span>Pedir Directo por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Scroll header shadow
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('shadow-md');
      } else {
        header.classList.remove('shadow-md');
      }
    }
  });
</script>
