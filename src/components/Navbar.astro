---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { buildWhatsAppLink } from '../lib/format';
import logoImg from '../assets/logo-oficial.png';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const waUrl = buildWhatsAppLink(RESTAURANT_INFO.whatsapp, RESTAURANT_INFO.whatsappDefaultMessage);

const links = [
  { href: '#inicio', label: 'Inicio', mobileLabel: 'Inicio' },
  { href: '#destacados', label: 'Especialidades', mobileLabel: 'Especialidades' },
  { href: '#menu', label: 'La Carta', mobileLabel: 'La Carta Completa' },
  { href: '#tradicion', label: 'Tradición', mobileLabel: 'Nuestra Tradición' },
  { href: '#contacto', label: 'Ubicación', mobileLabel: 'Ubicación & Horarios' },
];
---

<header id="main-header" class="sticky top-0 z-50 w-full border-b border-ink/15 bg-cream/95 backdrop-blur-md transition-shadow duration-300">
  <div class="mx-auto flex h-(--header-h) max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="#top" class="flex items-center rounded-sm py-1" aria-label="La Brasa Criolla - Inicio">
      <Image
        src={logoImg}
        alt=""
        height={130}
        loading="eager"
        class="h-11 w-auto object-contain drop-shadow-sm sm:h-14 lg:h-16"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class="border-b-2 border-transparent py-1 text-sm font-bold uppercase tracking-wider text-ink transition-colors hover:border-brand-red hover:text-brand-red"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href={`tel:${RESTAURANT_INFO.phone}`}
        class="hidden items-center gap-1.5 text-sm font-bold text-ash transition-colors hover:text-ink lg:flex"
      >
        <Icon name="lucide:phone" class="size-4 text-brand-red" aria-hidden="true" />
        {RESTAURANT_INFO.phoneDisplay}
      </a>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 items-center justify-center gap-2 rounded-sm border border-brand-red-dark bg-brand-red px-4 text-sm font-extrabold uppercase tracking-wide text-white transition-colors hover:bg-brand-red-dark"
      >
        <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
        Encargar por WhatsApp
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-sm border border-ink/20 text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Icon name="lucide:menu" class="size-6" data-icon-open aria-hidden="true" />
      <Icon name="lucide:x" class="hidden size-6" data-icon-close aria-hidden="true" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/15 bg-cream px-4 pb-5 md:hidden">
    <nav aria-label="Navegación móvil">
      <ul class="divide-y divide-ink/10">
        {links.map((link) => (
          <li>
            <a href={link.href} class="flex min-h-13 items-center text-base font-bold uppercase tracking-wider text-ink">
              {link.mobileLabel}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 flex h-12 w-full items-center justify-center gap-2 rounded-sm border border-brand-red-dark bg-brand-red text-sm font-extrabold uppercase tracking-wide text-white"
    >
      <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
      Encargar por WhatsApp
    </a>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');

  if (menuButton && mobileMenu) {
    const setOpen = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      mobileMenu.classList.toggle('hidden', !open);
      menuButton.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      menuButton.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    menuButton.addEventListener('click', () => setOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  }

  window.addEventListener('scroll', () => header?.classList.toggle('shadow-md', window.scrollY > 20), { passive: true });
</script>
