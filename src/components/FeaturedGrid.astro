---
import { MENU_ITEMS } from '../data/menu';
import DishTile from './DishTile.astro';
import { Icon } from 'astro-icon/components';

const featuredDishes = MENU_ITEMS.filter((dish) => dish.featured).slice(0, 4);
---

<section id="destacados" class="border-b border-ink/15 bg-cream py-14 sm:py-24" aria-labelledby="destacados-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col justify-between gap-3 md:mb-12 md:flex-row md:items-end">
      <div>
        <p class="mb-2 text-xs font-extrabold uppercase tracking-widest text-brand-red">Orgullo Parrillero de La Plata, Huila</p>
        <h2 id="destacados-title" class="font-display text-4xl uppercase leading-none tracking-wide text-ink sm:text-5xl lg:text-6xl">
          Especialidades Asadas al Carbón
        </h2>
      </div>
      <p class="max-w-md text-base text-ash">
        Los platos criollos más pedidos por locales y visitantes en La Plata: carnes de res, pollo dorado a la brasa y picadas
        familiares.
      </p>
    </div>

    <ul
      class="no-scrollbar -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 lg:grid-cols-4"
    >
      {featuredDishes.map((dish) => (
        <li class="w-[78%] shrink-0 snap-start sm:w-auto">
          <DishTile dish={dish} headingLevel="h3" />
        </li>
      ))}
    </ul>

    <div
      class="mt-10 flex flex-col items-start gap-4 rounded-sm border border-hairline bg-cream-muted p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex items-start gap-3">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-sm bg-ink text-brand-gold">
          <Icon name="lucide:star" class="size-5" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-display text-xl uppercase tracking-wide text-ink">¿Vienes en familia o grupo?</h3>
          <p class="text-sm text-ash">Nuestra Picada Mixta y el Pollo Entero son ideales para compartir entre 3 a 5 personas.</p>
        </div>
      </div>
      <a
        href="#menu"
        class="inline-flex min-h-11 items-center gap-2 text-sm font-extrabold uppercase tracking-wide text-ink underline decoration-2 underline-offset-4 transition-colors hover:text-brand-red"
      >
        Ver los {MENU_ITEMS.length} platos de la carta
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
