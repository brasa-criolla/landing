---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { buildWhatsAppLink } from '../lib/format';
import { Icon } from 'astro-icon/components';

const scheduledOrderUrl = buildWhatsAppLink(RESTAURANT_INFO.whatsapp, 'Hola, quisiera hacer un pedido programado para recoger');

const milestones = [
  { value: '1990', detail: 'Más de 35 años de tradición parrillera familiar.' },
  { value: '8 Mesas', detail: 'Nuestros orígenes con vocación y amor al servicio.' },
  { value: '100%', detail: 'Leña y carbón natural sin atajos ni aditivos.' },
];
---

<section id="tradicion" class="border-y border-ink/15 bg-cream-muted py-14 sm:py-24" aria-labelledby="tradicion-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-md bg-ink p-6 text-white shadow-xl sm:p-12 lg:p-16">
      <div class="pointer-events-none absolute -bottom-24 -right-24 size-96 rounded-full bg-brand-red/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -left-24 -top-24 size-96 rounded-full bg-brand-gold/10 blur-3xl"></div>

      <div class="relative z-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="mb-5 inline-flex rounded-sm bg-brand-gold px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-ink">
            Sello Artesanal
          </p>

          <h2
            id="tradicion-title"
            class="mb-6 font-display text-4xl uppercase leading-[1.05] tracking-wide text-cream sm:text-5xl lg:text-6xl"
          >
            {RESTAURANT_INFO.qualityPromiseTitle}
          </h2>

          <blockquote class="my-6 border-l-2 border-brand-gold pl-4 sm:pl-6">
            <p class="text-base leading-relaxed text-hairline sm:text-lg">"{RESTAURANT_INFO.qualityPromiseQuote}"</p>
          </blockquote>

          <p class="mb-8 text-base leading-relaxed text-hairline">
            Fundado el <strong>18 de marzo de 1990</strong> en La Plata por la <strong>Familia Luengas Rueda</strong> (Elsa
            María Rueda y Rubén Luengas). Iniciamos con tan solo 8 mesas y el compromiso inquebrantable de llevar a cada
            comensal el auténtico asado al carbón del Huila.
          </p>

          <ul class="grid grid-cols-1 gap-5 border-t border-white/15 pt-6 sm:grid-cols-3">
            {milestones.map((item) => (
              <li>
                <span class="mb-1 block font-display text-[1.75rem] uppercase leading-none text-brand-gold">{item.value}</span>
                <span class="text-sm font-semibold text-hairline">{item.detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col items-center justify-center lg:col-span-5">
          <div class="w-full rounded-lg border border-white/20 bg-[#381200] p-6 text-center shadow-lg sm:p-8">
            <div
              class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full border-2 border-brand-gold bg-brand-red text-white shadow-inner"
            >
              <Icon name="lucide:flame" class="size-8" aria-hidden="true" />
            </div>
            <p class="mb-1 font-display text-[1.75rem] uppercase text-cream">¿Deseas tu pedido listo al llegar?</p>
            <p class="mb-6 text-sm text-hairline">
              Escríbenos con anticipación por WhatsApp para tener tus platos recién salidos de la parrilla listos para
              recoger.
            </p>
            <a
              href={scheduledOrderUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm border border-brand-gold-deep bg-brand-gold px-6 font-display text-xl uppercase tracking-wider text-ink shadow-md transition-colors hover:bg-[#D4B600]"
            >
              Encargar Pedido
              <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
