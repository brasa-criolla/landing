---
import type { Dish } from '../data/menu';
import { formatCOP } from '../lib/format';
import { Image } from 'astro:assets';

interface Props {
  dish: Dish;
  headingLevel: 'h3' | 'h4';
}

const { dish, headingLevel } = Astro.props;
const Heading = headingLevel;
---

<article class="relative flex gap-3.5 py-4">
  {dish.image && (
    <Image
      src={dish.image}
      alt=""
      widths={[176, 264]}
      sizes="88px"
      loading="lazy"
      decoding="async"
      class="size-22 shrink-0 rounded-sm bg-cream-muted object-cover"
    />
  )}
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <Heading class="font-display text-[1.375rem] uppercase leading-[1.05] tracking-wide text-ink">{dish.name}</Heading>
      <p class="shrink-0 whitespace-nowrap pt-0.5 text-base font-extrabold leading-tight tabular-nums text-ink">
        {formatCOP(dish.price)}
      </p>
    </div>
    {dish.badge && (
      <p class="mt-1.5 inline-block rounded-sm bg-brand-gold px-1.5 py-0.5 text-xs font-extrabold uppercase tracking-wide text-ink">
        {dish.badge}
      </p>
    )}
    <p class="mt-1 line-clamp-2 text-sm leading-snug text-ash">{dish.accompaniments.join(' · ')}</p>
  </div>
  <button
    type="button"
    class="absolute inset-0 rounded-sm transition-colors active:bg-ink/5"
    data-dish-open={dish.id}
    aria-label={`Ver detalle de ${dish.name}`}
  ></button>
</article>
