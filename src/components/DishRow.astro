---
import { CATEGORIES, type Dish } from '../data/menu';
import { formatCOP } from '../lib/format';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  dish: Dish;
  headingLevel: 'h3' | 'h4';
}

const { dish, headingLevel } = Astro.props;
const Heading = headingLevel;
const hasPrice = dish.price !== undefined;
const placeholderIcon = CATEGORIES.find((category) => category.id === dish.category)?.icon ?? 'lucide:utensils';
---

<article class="relative flex gap-3.5 py-4">
  {dish.image ? (
    <Image
      src={dish.image}
      alt=""
      widths={[176, 264]}
      sizes="88px"
      loading="lazy"
      decoding="async"
      class="size-22 shrink-0 rounded-sm bg-cream-muted object-cover"
    />
  ) : (
    <div class="flex size-22 shrink-0 items-center justify-center rounded-sm bg-cream-muted text-ash/60" aria-hidden="true">
      <Icon name={placeholderIcon} class="size-8" />
    </div>
  )}
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <Heading class="font-display text-[1.375rem] uppercase leading-[1.05] tracking-wide text-ink">{dish.name}</Heading>
      <p
        class:list={[
          'shrink-0 whitespace-nowrap pt-0.5 leading-tight tabular-nums',
          hasPrice ? 'text-base font-extrabold text-ink' : 'text-sm font-bold text-ash',
        ]}
      >
        {hasPrice ? formatCOP(dish.price!) : 'Consultar'}
      </p>
    </div>
    {dish.accompaniments.length > 0 && (
      <p class="mt-1 line-clamp-2 text-sm leading-snug text-ash">{dish.accompaniments.join(' · ')}</p>
    )}
    {dish.availability && <p class="mt-1 text-sm font-semibold text-ink-soft">Solo {dish.availability.toLowerCase()}</p>}
  </div>
  <button
    type="button"
    class="absolute inset-0 rounded-sm transition-colors active:bg-ink/5"
    data-dish-open={dish.id}
    aria-label={`Ver detalle de ${dish.name}`}
  ></button>
</article>
