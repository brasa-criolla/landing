---
import { MENU_ITEMS } from '../data/menu';
import MenuList from './MenuList.astro';
---

<section id="menu" class="bg-cream py-14 sm:py-24" aria-labelledby="menu-title">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-8 max-w-3xl text-center">
      <p class="mb-2 text-xs font-extrabold uppercase tracking-widest text-brand-red">Carta & Menú en La Plata, Huila</p>
      <h2 id="menu-title" class="font-display text-4xl uppercase leading-none tracking-wide text-ink sm:text-6xl">
        Menú de Asados & Platos Criollos
      </h2>
      <p class="mt-3 text-base text-ash">
        Explora {MENU_ITEMS.length} opciones preparadas al instante: carnes a la brasa, pollo asado, pescados y arroces con
        acompañamientos tradicionales. Toca un plato para ver el detalle.
      </p>
    </div>

    <MenuList headingLevel="h3" allowOrdering={true} />

    <p class="mt-10 border-t border-hairline pt-6 text-center text-sm text-ash">
      Todos los precios están expresados en Pesos Colombianos (COP) e incluyen los impuestos aplicables. Los
      acompañamientos pueden variar según disponibilidad del día.
    </p>
  </div>
</section>
