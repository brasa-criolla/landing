---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { MENU_ITEMS } from '../data/menu';
import { buildWhatsAppLink } from '../lib/format';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heroImg from '../assets/hero-asado.jpg';
import OpenStatus from './OpenStatus.astro';

const waHeroUrl = buildWhatsAppLink(
  RESTAURANT_INFO.whatsapp,
  '¡Hola! Vengo de la página web y me gustaría encargar un pedido para recoger.',
);

const highlights = [
  { title: '100% Carbón', detail: 'Leña & brasa natural' },
  { title: 'Hecho al Momento', detail: 'Máxima frescura' },
  { title: 'Carta Completa', detail: `${MENU_ITEMS.filter((item) => item.category !== 'bebidas').length} platos típicos` },
  { title: RESTAURANT_INFO.address, detail: `${RESTAURANT_INFO.city}, ${RESTAURANT_INFO.department}` },
];
---

<section
  id="inicio"
  class="relative flex items-center justify-center overflow-hidden bg-ink text-white sm:min-h-[85vh] lg:min-h-[90vh]"
>
  <div class="absolute inset-0" aria-hidden="true">
    <!-- Shown at 40% opacity under a gradient, so phones get a deliberately low-resolution file. -->
    <Image
      src={heroImg}
      alt=""
      widths={[640, 960, 1600]}
      sizes="(min-width: 1024px) 100vw, 55vw"
      quality={60}
      loading="eager"
      fetchpriority="high"
      class="size-full scale-105 object-cover object-center opacity-40 contrast-110"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-ink/40 to-ink"></div>
  </div>

  <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center px-4 py-12 text-center sm:px-6 sm:py-20 lg:px-8">
    <OpenStatus class="mb-6 rounded-sm bg-brand-gold px-3 py-1.5 text-sm font-bold text-ink shadow-sm" />

    <h1
      class="mb-5 max-w-4xl text-balance font-display text-[2.75rem] uppercase leading-[0.95] tracking-wide text-cream sm:mb-6 sm:text-7xl lg:text-8xl"
    >
      <span class="mb-3 block font-body text-xs font-extrabold uppercase tracking-[0.2em] text-brand-gold sm:text-sm">
        Restaurante & Asadero en La Plata, Huila
      </span>
      El Auténtico Sabor del <span class="text-brand-gold">Asado al Carbón</span>
    </h1>

    <p class="mx-auto mb-8 max-w-2xl text-pretty text-base leading-relaxed text-hairline sm:mb-10 sm:text-xl lg:text-2xl">
      Carnes jugosas a la brasa, pollo dorado al carbón y recetas típicas colombianas preparadas en el instante de su pedido.
    </p>

    <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-4">
      <a
        href="#menu"
        class="inline-flex h-13 w-full items-center justify-center gap-2 rounded-sm border border-brand-red-dark bg-brand-red px-8 font-display text-xl uppercase tracking-wider text-white shadow-lg transition-colors hover:bg-brand-red-dark sm:w-auto"
      >
        Ver Toda la Carta
        <Icon name="lucide:chevron-down" class="size-5" aria-hidden="true" />
      </a>
      <a
        href={waHeroUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-13 w-full items-center justify-center gap-2 rounded-sm border border-cream/40 px-7 font-display text-xl uppercase tracking-wider text-cream transition-colors hover:border-brand-gold hover:bg-cream/10 hover:text-brand-gold sm:w-auto"
      >
        <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
        Encargar para Recoger
      </a>
    </div>

    <ul class="mt-16 hidden w-full grid-cols-2 gap-4 border-t border-cream/15 pt-10 sm:grid md:grid-cols-4">
      {highlights.map((item) => (
        <li class="p-2">
          <span class="block font-display text-[1.75rem] uppercase text-brand-gold">{item.title}</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-hairline">{item.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
