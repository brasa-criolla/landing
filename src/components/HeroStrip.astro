---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { Icon } from 'astro-icon/components';
---

<section
  class="border-y border-ink/20 bg-gradient-to-r from-[#7d5500] via-[#976500] to-[#7d5500] px-4 py-4 text-white sm:py-3.5"
  aria-label="Promesa Brasa Criolla"
>
  <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-3">
      <span class="shrink-0 rounded-sm bg-ink px-2.5 py-1 text-xs font-extrabold uppercase tracking-wider text-brand-gold">
        Promesa Brasa Criolla
      </span>
      <p class="text-sm font-semibold leading-snug">{RESTAURANT_INFO.qualityPromiseQuote}</p>
    </div>
    <a
      href="#menu"
      class="inline-flex min-h-11 shrink-0 items-center gap-1.5 self-start text-sm font-extrabold uppercase tracking-wide underline underline-offset-4 transition-colors hover:text-brand-gold sm:self-auto"
    >
      Explorar Categorías
      <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
