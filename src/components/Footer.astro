---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import { CATEGORIES, MENU_ITEMS } from '../data/menu';
import logoImg from '../assets/logo-oficial.png';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();
const iconFor = (categoryId: string) => CATEGORIES.find((category) => category.id === categoryId)?.icon ?? 'lucide:utensils';

const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#destacados', label: 'Platos Estrella' },
  { href: '#menu', label: `Carta Completa (${MENU_ITEMS.length} Platos)` },
  { href: '/carta', label: 'Carta Digital para la Mesa' },
  { href: '#tradicion', label: 'Nuestra Tradición al Carbón' },
  { href: '#contacto', label: 'Horarios y Ubicación' },
];

const specialties = [
  { category: 'carnes', label: 'Carnes Asadas (Churrasco, Bistek, Lomo BBQ)' },
  { category: 'pollo', label: 'Pollo al Carbón y Broaster Apanado' },
  { category: 'pescado', label: 'Pescados (Mojarra Frita, Bagre, Trucha)' },
  { category: 'arroz', label: 'Arroz con Pollo & Camarones' },
  { category: 'bebidas', label: 'Limonada de Panela Campesina & Jugos Naturales' },
];
---

<footer class="border-t border-black bg-ink pb-24 pt-14 text-cream sm:pb-12 sm:pt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 border-b border-white/10 pb-10 md:grid-cols-2 lg:grid-cols-12 lg:pb-12">
      <div class="space-y-4 lg:col-span-5">
        <a href="#top" class="inline-block rounded-sm bg-cream p-2" aria-label="Volver al inicio">
          <Image src={logoImg} alt="" height={130} class="h-14 w-auto object-contain" />
        </a>

        <p class="max-w-sm text-sm leading-relaxed text-hairline">{RESTAURANT_INFO.description}</p>

        <address class="space-y-1 text-sm font-semibold not-italic text-brand-gold">
          <span class="flex items-center gap-1.5">
            <Icon name="lucide:map-pin" class="size-4 shrink-0" aria-hidden="true" />
            {RESTAURANT_INFO.address}, {RESTAURANT_INFO.neighborhood}
          </span>
          <span class="block">{RESTAURANT_INFO.city}, {RESTAURANT_INFO.department} · Colombia</span>
        </address>

        <div class="flex flex-wrap items-center gap-3">
          {RESTAURANT_INFO.socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 items-center justify-center rounded-sm border border-white/15 bg-[#381200] text-white transition-colors hover:bg-brand-red"
              aria-label={social.name}
            >
              <Icon name={`simple-icons:${social.icon}`} class="size-5" aria-hidden="true" />
            </a>
          ))}
          <span class="text-sm font-semibold text-hairline">@restaurantelabrasacri0lla</span>
        </div>
      </div>

      <nav class="lg:col-span-3" aria-labelledby="footer-nav-title">
        <h2 id="footer-nav-title" class="mb-2 font-display text-xl uppercase tracking-wider text-brand-gold">Navegación</h2>
        <ul class="text-sm font-semibold text-hairline">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center transition-colors hover:text-brand-gold">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <h2 class="mb-3 font-display text-xl uppercase tracking-wider text-brand-gold">Especialidades del Menú</h2>
        <ul class="space-y-2.5 text-sm font-semibold text-hairline">
          {specialties.map((item) => (
            <li class="flex items-center gap-2">
              <Icon name={iconFor(item.category)} class="size-4 shrink-0" aria-hidden="true" />
              <span>{item.label}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 border-t border-white/10 pt-4">
          <span class="block text-sm text-hairline">Contacto Directo:</span>
          <div class="flex flex-col sm:flex-row sm:items-center sm:gap-5">
            <a
              href={`tel:${RESTAURANT_INFO.phone}`}
              class="inline-flex min-h-11 items-center text-base font-extrabold tabular-nums text-white transition-colors hover:text-brand-gold"
            >
              {RESTAURANT_INFO.phoneDisplay}
            </a>
            <a
              href="tel:+576088371470"
              class="inline-flex min-h-11 items-center text-base font-extrabold tabular-nums text-white transition-colors hover:text-brand-gold"
            >
              Fijo: {RESTAURANT_INFO.phoneLandline}
            </a>
          </div>
          <a href={`mailto:${RESTAURANT_INFO.email}`} class="inline-flex min-h-11 items-center text-sm text-hairline hover:underline">
            {RESTAURANT_INFO.email}
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-center text-xs text-hairline sm:flex-row sm:text-left">
      <p>© {currentYear} <strong>La Brasa Criolla</strong>. Todos los derechos reservados. Barrio Páez · La Plata, Huila.</p>
      <p class="font-display text-xl uppercase tracking-wider text-brand-gold">{RESTAURANT_INFO.motto}</p>
    </div>
  </div>
</footer>
