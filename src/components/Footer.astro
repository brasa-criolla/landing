---
import { RESTAURANT_INFO } from '../data/restaurant-info';
import logoImg from '../assets/logo-oficial.png';
import { Image } from 'astro:assets';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#451400] text-[#FCF9EC] border-t border-black pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand & Bio (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <a href="#top" class="inline-block group" aria-label="Volver al inicio">
          <Image 
            src={logoImg} 
            alt="La Brasa Criolla — Asadero & Restaurante" 
            class="h-16 w-auto max-w-[220px] object-contain transition-transform duration-200 group-hover:scale-105"
            height={130}
          />
        </a>

        <p class="font-body text-xs sm:text-sm text-[#D4CBC7] max-w-sm leading-relaxed">
          {RESTAURANT_INFO.description}
        </p>

        <div class="pt-2 text-xs text-[#FDDC32] font-semibold space-y-1">
          <div>📍 {RESTAURANT_INFO.address}, {RESTAURANT_INFO.neighborhood}</div>
          <div>{RESTAURANT_INFO.city}, {RESTAURANT_INFO.department} · Colombia</div>
        </div>

        <!-- Social Media Real Links -->
        <div class="flex items-center gap-3 pt-2">
          {RESTAURANT_INFO.socialLinks.map((social) => (
            <a 
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-8 h-8 rounded-[4px] bg-[#381200] hover:bg-[#C60101] text-white border border-white/15 transition-colors text-xs font-bold"
              aria-label={social.name}
            >
              {social.icon === 'instagram' && '📸'}
              {social.icon === 'facebook' && '📘'}
              {social.icon === 'whatsapp' && '💬'}
            </a>
          ))}
          <span class="text-xs text-[#D4CBC7] font-semibold">@restaurantelabrasacri0lla</span>
        </div>
      </div>

      <!-- Col 2: Fast Navigation (3 cols) -->
      <div class="lg:col-span-3">
        <h4 class="font-display text-xl uppercase tracking-wider text-[#FDDC32] mb-4">
          Navegación
        </h4>
        <ul class="space-y-2.5 font-body text-xs sm:text-sm font-semibold text-[#D4CBC7]">
          <li>
            <a href="#inicio" class="hover:text-[#FDDC32] transition-colors">Inicio</a>
          </li>
          <li>
            <a href="#destacados" class="hover:text-[#FDDC32] transition-colors">Platos Estrella</a>
          </li>
          <li>
            <a href="#menu" class="hover:text-[#FDDC32] transition-colors">Carta Completa (35+ Platos)</a>
          </li>
          <li>
            <a href="#tradicion" class="hover:text-[#FDDC32] transition-colors">Nuestra Tradición al Carbón</a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-[#FDDC32] transition-colors">Horarios y Ubicación</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Categorías de la Carta (4 cols) -->
      <div class="lg:col-span-4">
        <h4 class="font-display text-xl uppercase tracking-wider text-[#FDDC32] mb-4">
          Especialidades del Menú
        </h4>
        <ul class="space-y-2.5 font-body text-xs sm:text-sm font-semibold text-[#D4CBC7]">
          <li>🥩 Carnes Asadas (Churrasco, Bistek, Lomo BBQ)</li>
          <li>🍗 Pollo al Carbón y Broaster Apanado</li>
          <li>🐟 Pescados (Mojarra Frita, Bagre, Trucha)</li>
          <li>🍚 Arroz con Pollo & Camarones</li>
          <li>🥤 Limonada de Panela Campesina & Jugos Naturales</li>
        </ul>

        <div class="mt-6 pt-4 border-t border-white/10 space-y-1">
          <span class="text-xs text-[#D4CBC7] block">Contacto Directo:</span>
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
            <a href={`tel:${RESTAURANT_INFO.phone}`} class="font-display text-xl text-white hover:text-[#FDDC32] transition-colors">
              {RESTAURANT_INFO.phoneDisplay}
            </a>
            <span class="text-[#FDDC32] hidden sm:inline">·</span>
            <a href="tel:6088371470" class="font-display text-xl text-white hover:text-[#FDDC32] transition-colors">
              Fijo: {RESTAURANT_INFO.phoneLandline}
            </a>
          </div>
          <a href={`mailto:${RESTAURANT_INFO.email}`} class="text-xs text-[#D4CBC7] hover:underline block pt-0.5">
            {RESTAURANT_INFO.email}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar with Authentic Plateño Motto -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#D4CBC7]">
      <p>
        © {currentYear} <strong>La Brasa Criolla</strong>. Todos los derechos reservados. Barrio Páez · La Plata, Huila.
      </p>
      <p class="font-display text-base tracking-wider text-[#FDDC32] uppercase">
        {RESTAURANT_INFO.motto}
      </p>
    </div>
  </div>
</footer>
